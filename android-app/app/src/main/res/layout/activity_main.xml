<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:background="@color/background" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/title" android:textColor="@color/foreground" android:textSize="25sp"
        android:textStyle="bold" android:gravity="start" android:accessibilityHeading="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/offline" android:textColor="@color/accent" android:textSize="13sp"
        android:gravity="start" android:paddingBottom="12dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#000000">
        <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent"
            android:layout_height="match_parent" android:contentDescription="@string/preview_description" />
        <ir.platelens.app.PlateOverlay android:id="@+id/overlay" android:layout_width="match_parent"
            android:layout_height="match_parent" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal" android:layout_margin="8dp"
            android:orientation="horizontal" android:layoutDirection="ltr" android:padding="4dp" android:background="@drawable/card">
            <Button android:id="@+id/zoom_out" style="@style/ActionButton" android:layout_width="52dp"
                android:layout_height="48dp" android:minHeight="48dp" android:text="−" android:contentDescription="@string/zoom_out" android:enabled="false" />
            <Button android:id="@+id/zoom_reset" style="@style/ActionButton" android:layout_width="88dp"
                android:layout_height="48dp" android:minHeight="48dp" android:text="1.0×" android:contentDescription="@string/zoom_reset" android:enabled="false" />
            <Button android:id="@+id/zoom_in" style="@style/ActionButton" android:layout_width="52dp"
                android:layout_height="48dp" android:minHeight="48dp" android:text="+" android:contentDescription="@string/zoom_in" android:enabled="false" />
        </LinearLayout>
    </FrameLayout>
    <Button android:id="@+id/backend" style="@style/ActionButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/loading" android:enabled="false" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/loading" android:textColor="@color/muted" android:textSize="14sp"
        android:gravity="center" android:padding="10dp" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp" android:background="@drawable/card">
        <ImageView android:id="@+id/crop" android:layout_width="match_parent" android:layout_height="62dp"
            android:scaleType="fitCenter" android:contentDescription="@string/crop_description" android:visibility="gone" />
        <ir.platelens.app.PlateTextView android:id="@+id/plate_text" android:layout_width="match_parent"
            android:layout_height="54dp" android:contentDescription="@string/no_plate" />
        <TextView android:id="@+id/quality" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/no_plate" android:textColor="@color/muted" android:textSize="13sp"
            android:gravity="center" />
        <TextView android:id="@+id/timing" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:paddingTop="5dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="10dp">
        <Button android:id="@+id/toggle" style="@style/ActionButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.5" android:text="@string/start"
            android:backgroundTint="@color/primary_button" android:textColor="@color/primary_text" android:enabled="false" />
        <Button android:id="@+id/torch" style="@style/ActionButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/torch" android:enabled="false" />
        <Button android:id="@+id/copy" style="@style/ActionButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.3" android:text="@string/copy" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
